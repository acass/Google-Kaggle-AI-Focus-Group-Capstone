      "id": "file:backend/plugins/blue_team_plugin.py",
      "type": "file",
      "name": "blue_team_plugin.py",
      "filePath": "backend/plugins/blue_team_plugin.py",
      "summary": "Google ADK plugin implementing the Blue Team defender role: records every tool invocation in a runtime AgBOM, calculates a decaying trust score, and sets a quarantine flag when trust drops below 50.",
      "tags": ["middleware", "security", "event-handler", "monitoring"],
      "complexity": "simple",
      "languageNotes": "Uses the ADK after_tool_callback hook pattern to observe tool invocations post-execution without blocking them."
    },
    {
      "id": "class:backend/plugins/blue_team_plugin.py:BlueTeamAnalyticsPlugin",
      "type": "class",
      "name": "BlueTeamAnalyticsPlugin",
      "filePath": "backend/plugins/blue_team_plugin.py",
      "lineRange": [7, 46],
      "summary": "ADK BasePlugin subclass that monitors agent tool usage, maintains an AgBOM audit log and trust score in session state, and signals quarantine when the trust score decays below threshold.",
      "tags": ["middleware", "security", "monitoring"],
      "complexity": "moderate"
    },
    {
      "id": "file:backend/plugins/green_team_plugin.py",
      "type": "file",
      "name": "green_team_plugin.py",
      "filePath": "backend/plugins/green_team_plugin.py",
      "summary": "Google ADK plugin implementing the Green Team fixer role: intercepts every tool call before execution and raises a RuntimeError to halt the agent if the Blue Team has set the quarantine flag.",
      "tags": ["middleware", "security", "event-handler"],
      "complexity": "simple",
      "languageNotes": "Uses the ADK before_tool_callback hook to enforce a stateful quarantine — the session state is preserved for forensic analysis while blocking further tool execution."
    },
    {
      "id": "class:backend/plugins/green_team_plugin.py:GreenTeamQuarantinePlugin",
      "type": "class",
      "name": "GreenTeamQuarantinePlugin",
      "filePath": "backend/plugins/green_team_plugin.py",
      "lineRange": [7, 27],
      "summary": "ADK BasePlugin subclass that enforces stateful quarantine by blocking all tool invocations when the quarantine_flag in session state is True, preserving state for post-incident forensics.",
      "tags": ["middleware", "security"],
      "complexity": "simple"
    }
