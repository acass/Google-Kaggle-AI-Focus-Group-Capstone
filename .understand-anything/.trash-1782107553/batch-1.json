      "id": "file:frontend/app/types/index.ts",
      "type": "file",
      "name": "index.ts",
      "filePath": "frontend/app/types/index.ts",
      "summary": "Central TypeScript type definitions barrel for the AI Focus Group frontend, declaring all shared interfaces and types: ScoreSet, FinalReport, StreamEvent, PersonaMeta, Phase union, and FocusGroupSession. Every other frontend module imports from this file.",
      "tags": ["type-definition", "barrel", "entry-point"],
      "complexity": "simple"
    },
    {
      "id": "file:frontend/app/hooks/useFocusGroup.ts",
      "type": "file",
      "name": "useFocusGroup.ts",
      "filePath": "frontend/app/hooks/useFocusGroup.ts",
      "summary": "Custom React hook that manages the full focus group session lifecycle: creating sessions via POST to the backend, consuming a Server-Sent Events stream to accumulate StreamEvent messages, updating phase and score state in real time, and fetching the final report once the stream completes.",
      "tags": ["hook", "service", "event-handler", "api-handler"],
      "complexity": "moderate",
      "languageNotes": "Uses useCallback with a ref-tracked EventSource so the ES connection can be closed on reset without stale closure issues."
    },
    {
      "id": "function:frontend/app/hooks/useFocusGroup.ts:useFocusGroup",
      "type": "function",
      "name": "useFocusGroup",
      "filePath": "frontend/app/hooks/useFocusGroup.ts",
      "lineRange": [8, 118],
      "summary": "React hook exposing session state, loading/error flags, and start/reset callbacks. Orchestrates POST session creation, SSE streaming, real-time state updates, and final report hydration.",
      "tags": ["hook", "api-handler", "event-handler"],
      "complexity": "complex"
    },
    {
      "id": "file:frontend/app/page.tsx",
      "type": "file",
      "name": "page.tsx",
      "filePath": "frontend/app/page.tsx",
      "summary": "Root Next.js page component that composes the application shell: a fixed header, a left sidebar with TopicInput, a central DiscussionThread with optional FinalReport footer, and a right ScorePanel. Drives all child components through the useFocusGroup hook.",
      "tags": ["entry-point", "component", "api-handler"],
      "complexity": "simple",
      "languageNotes": "Uses the 'use client' directive — required because it consumes the useFocusGroup hook which manages EventSource and React state."
    },
