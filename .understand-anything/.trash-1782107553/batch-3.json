    {
      "id": "file:backend/models/state.py",
      "type": "file",
      "name": "state.py",
      "filePath": "backend/models/state.py",
      "summary": "Defines all shared TypedDict data models for the focus group session, including AgentPersona, ScoreSet, FinalReport, StreamEvent, and the central FocusGroupState that flows through the LangGraph/ADK workflow.",
      "tags": ["data-model", "type-definition", "schema-definition"],
      "complexity": "moderate"
    },
    {
      "id": "file:backend/agents/graph.py",
      "type": "file",
      "name": "graph.py",
      "filePath": "backend/agents/graph.py",
      "summary": "Constructs the Google ADK Workflow (focus_group_workflow) by wiring moderator, parallel participant, and synthesizer nodes together with JoinNodes for fan-out/fan-in coordination across the three focus group phases.",
      "tags": ["entry-point", "factory", "workflow", "orchestration"],
      "complexity": "moderate",
      "languageNotes": "Uses Python closure default-argument trick (_p=p) to correctly capture loop variables when dynamically creating per-participant ADK nodes."
    },
    {
      "id": "file:backend/agents/nodes/moderator.py",
      "type": "file",
      "name": "moderator.py",
      "filePath": "backend/agents/nodes/moderator.py",
      "summary": "Implements the two moderator workflow nodes: introduction (grounding the topic with real-world search results) and follow-up question generation (probing disagreements across independent participant responses), both backed by a Gemini 2.5 Pro LlmAgent.",
      "tags": ["api-handler", "service", "middleware"],
      "complexity": "moderate"
    },
    {
      "id": "file:backend/agents/nodes/participant.py",
      "type": "file",
      "name": "participant.py",
      "filePath": "backend/agents/nodes/participant.py",
      "summary": "Implements the three participant workflow node functions (independent response, discussion response, and structured vote scoring) using Gemini 2.5 Flash LlmAgents with persona-driven prompts and a Pydantic VoteScores output schema.",
      "tags": ["api-handler", "service", "factory"],
      "complexity": "complex"
    },
    {
      "id": "file:backend/agents/nodes/synthesizer.py",
      "type": "file",
      "name": "synthesizer.py",
      "filePath": "backend/agents/nodes/synthesizer.py",
      "summary": "Implements the final synthesizer workflow node: computes per-category score averages, standard deviations, and consensus confidence from all participant votes, then uses a Gemini 2.5 Pro LlmAgent with a structured SynthesisResult schema to produce the FinalReport.",
      "tags": ["service", "data-model", "validation"],
      "complexity": "complex"
    },
