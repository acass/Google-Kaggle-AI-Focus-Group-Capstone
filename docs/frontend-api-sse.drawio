    </mxCell>
    <mxCell id="L3b" value="&lt;b&gt;SseConnection&lt;/b&gt;&lt;br&gt;browser EventSource (package:web)&lt;br&gt;one connection &#183; no manual reconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBD0;strokeColor=#B87910;fontColor=#5a3d08;" vertex="1" parent="laneL">
