    <mxCell id="li2" value="createSession (await)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7EC7;fontSize=10;fontColor=#3a414d;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="L3a"><mxGeometry relative="1" as="geometry"/></mxCell>
