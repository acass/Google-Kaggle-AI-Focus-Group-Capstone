    <mxCell id="L3a" value="&lt;b&gt;api_client.createSession&lt;/b&gt;&lt;br&gt;REST &#183; POST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A5FC0;fontColor=#1e335f;" vertex="1" parent="laneL">
