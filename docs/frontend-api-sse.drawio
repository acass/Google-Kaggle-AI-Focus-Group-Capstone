    <mxCell id="c4" value="SSE stream: StreamEvent x N&#10;replay history, then live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#B87910;strokeWidth=2;fontSize=10;fontColor=#5a3d08;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="R4" target="L3b"><mxGeometry relative="1" as="geometry"/></mxCell>

