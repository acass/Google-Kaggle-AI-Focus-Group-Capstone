    <mxCell id="c6" value="{final_report}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9AA3B2;fontSize=10;fontColor=#3a414d;exitX=0;exitY=0.75;entryX=1;entryY=0.85;" edge="1" parent="1" source="R5" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- ===== legend ===== -->
    <mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&#8212; solid = request / call&lt;br&gt;&#8226;&#8226; dashed = response / event stream&lt;br&gt;amber = SSE channel &#183; blue = REST&lt;br&gt;one SSE connection per session; backend&lt;br&gt;replays full history on (re)connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FB;strokeColor=#C2CAD8;fontColor=#3a414d;align=left;spacingLeft=10;spacingTop=6;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
