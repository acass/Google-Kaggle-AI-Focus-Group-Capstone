    <mxCell id="li6" value="export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7EC7;fontSize=10;fontColor=#3a414d;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- ===== right internal edges ===== -->
    <mxCell id="ri1" value="spawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0C8A88;fontSize=10;fontColor=#0a3d3c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="ri2" value="append stream_events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0C8A88;fontSize=10;fontColor=#0a3d3c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R2" target="R3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="ri3" value="poll every 0.5s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9AA3B2;fontSize=10;fontColor=#3a414d;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R3" target="R4"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- ===== cross-lane edges ===== -->
    <mxCell id="c1" value="POST /sessions&#10;{topic, participant_ids}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3A5FC0;strokeWidth=2;fontSize=10;fontColor=#1e335f;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="L3a" target="R1"><mxGeometry relative="1" as="geometry"/></mxCell>
