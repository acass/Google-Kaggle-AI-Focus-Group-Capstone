    <!-- ===== left (client) nodes ===== -->
    <mxCell id="L1" value="&lt;b&gt;TopicInput&lt;/b&gt;&lt;br&gt;user enters topic + selects 1&#8211;5 personas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7EC7;fontColor=#22314f;" vertex="1" parent="laneL">
      <mxGeometry x="20" y="48" width="320" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="L2" value="&lt;b&gt;SessionNotifier.start()&lt;/b&gt;&lt;br&gt;Riverpod state machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7EC7;fontColor=#22314f;" vertex="1" parent="laneL">
