    </mxCell>
    <mxCell id="L4" value="&lt;b&gt;SessionNotifier._applyEvent&lt;/b&gt;&lt;br&gt;folds each event into state&lt;br&gt;&#8226; phase_change &#183; agent_message&lt;br&gt;&#8226; score_update &#183; report_complete&lt;br&gt;&#8226; error &#183; done (close SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7EC7;fontColor=#22314f;align=left;spacingLeft=12;" vertex="1" parent="laneL">
      <mxGeometry x="20" y="392" width="320" height="112" as="geometry"/>
    </mxCell>
    <mxCell id="L5" value="&lt;b&gt;UI widgets&lt;/b&gt;&lt;br&gt;DiscussionThread &#183; ScorePanel&lt;br&gt;FinalReportCard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7EC7;fontColor=#22314f;" vertex="1" parent="laneL">
      <mxGeometry x="20" y="528" width="320" height="82" as="geometry"/>
    </mxCell>
    <mxCell id="L6" value="&lt;b&gt;Export&lt;/b&gt;&lt;br&gt;PDF (printing) &#183; DOCX (OOXML / archive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEFF4;strokeColor=#9AA3B2;fontColor=#3a414d;" vertex="1" parent="laneL">
